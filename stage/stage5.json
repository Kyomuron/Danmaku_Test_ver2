    "ending": {
      "A": [
        { "speaker": "player", "text": "鬼ヶ島に行くまでにたくさんのVtuberさんに会った。" },
        { "speaker": "player", "text": "みんな濃いキャラクターで、それぞれ一生懸命に活動していた。" },
        { "speaker": "player", "text": "活動にかける熱量や自分のセールスポイントは千差万別。" },
        { "speaker": "player", "text": "ゲーム実況や歌配信などのエンタメ系、情報伝達系、クリエイター系、教育系。" },
        { "speaker": "player", "text": "ジャンルの幅広さがゆえに、知名度を伸ばすことは難しい。" },
        { "speaker": "player", "text": "一方で、どんな人でも受け入れる懐の深さを見せてくれる活動者業界。" },
        { "speaker": "player", "text": "これから虚無ろんはどんな未来に進んでいくのか。" },
        { "speaker": "player", "text": "是非、温かく見守ってくれると嬉しいな。" },
        { "speaker": "player", "text": "Thank you for playing!" }
      ],
      "B": [
        { "speaker": "player", "text": "自機B、遊んでくれてありがとう！" },
        { "speaker": "player", "text": "こっちの方が少し難しかったのではないかしら？" },
        { "speaker": "player", "text": "それでは以下、あとがきです。" },
        { "speaker": "player", "text": "登場キャラクターを考えている時、めっちゃ楽しかった。" },
        { "speaker": "player", "text": "イラストを描くのも楽しかったし、コーディングしている時も楽しかった。" },
        { "speaker": "player", "text": "これまで自分はあまりクリエイティブな方ではないかなと思っていたけど、意外とできるもんだなぁという気持ちになりました。" },
        { "speaker": "player", "text": "配信活動を通して、自分の知られざる一面に触れることができました。" },
        { "speaker": "player", "text": "このエンディングを見ている人はごく少数かもしれないけど、僕はニッチな層にニッチなものを届ける活動者なのでよいのです！" },
        { "speaker": "player", "text": "それでは、また動画で会いましょう！" },
        { "speaker": "player", "text": "Thank you for playing!" }
      ]
    }
